# Copy to .env.local. Everything here is read server-side only (src/lib/**); nothing is NEXT_PUBLIC_
# except the app URL.

# ── Model inference (pick at least one). Wally (RunAnywhere) is the sponsor path.
RUNANYWHERE_API_KEY=                        # Cloud key from https://console.runanywhere.ai (starts with sk-runa-)
WALLY_BASE_URL=https://inference.runanywhere.ai/v1
WALLY_MODEL=glm-5.3-flash                   # checked against GET /v1/models at boot; also listed today:
                                            # deepseek-v4.1-flash, mimo-v2.6-pro, muse-spark
RELAY_BUILDER_MODEL=                        # optional: a different Wally model for the Builder only (longest outputs)
# Fallbacks (used only if the Wally key is missing or a Wally call fails)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-mini
# Force a provider to the front of the order: wally | anthropic | openai  (default: wally, anthropic, openai)
RELAY_LLM_PROVIDER=

# ── Sandboxed execution. With a Freestyle key, every workspace gets a real Linux VM
#    and a public https://relay-<workspaceId>.style.dev preview. Without it, Relay uses a
#    clearly-labelled local static host (never pretends to be Freestyle).
FREESTYLE_API_KEY=                          # npx freestyle@latest login && npx freestyle@latest tokens create relay
RELAY_PREVIEW_DOMAIN_SUFFIX=style.dev

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # public origin of this server; set to http://<lan-ip>:3000 when a
                                            # second device must load local-fallback previews
RELAY_DATA_DIR=                             # optional: where relay.json + local artifacts live (default ./data)
